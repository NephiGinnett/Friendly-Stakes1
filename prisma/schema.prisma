generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id        Int       @id @default(autoincrement())
  username  String    @unique
  pinHash   String
  pinSalt   String
  points    Int       @default(1000)
  isAdmin   Boolean   @default(false)
  createdAt DateTime  @default(now())

  sessions       Session[]
  createdWagers  Wager[]        @relation("creator")
  wagerEntries   WagerEntry[]
  counterOffers  CounterOffer[]
  votes          Vote[]
}

model Session {
  id        String   @id @default(cuid())
  userId    Int
  user      User     @relation(fields: [userId], references: [id])
  token     String   @unique
  createdAt DateTime @default(now())
}

model Wager {
  id              Int      @id @default(autoincrement())
  title           String
  description     String?
  creatorId       Int
  creator         User     @relation("creator", fields: [creatorId], references: [id])
  creatorPosition String
  creatorStake    Int

  deadline   DateTime
  status     String   @default("open") // open, started, voting, settled, cancelled
  winnerSide String?  // "for" or "against"
  settledAt  DateTime?
  settledBy  String?  // "vote" or "admin"

  createdAt     DateTime       @default(now())
  entries       WagerEntry[]
  counterOffers CounterOffer[]
  votes         Vote[]
}

// Each person who joins a wager (besides the creator, who is implicit "for")
model WagerEntry {
  id        Int      @id @default(autoincrement())
  wagerId   Int
  wager     Wager    @relation(fields: [wagerId], references: [id])
  userId    Int
  user      User     @relation(fields: [userId], references: [id])
  side      String   // "for" (agrees with creator) or "against"
  stake     Int
  createdAt DateTime @default(now())

  @@unique([wagerId, userId])
}

model CounterOffer {
  id               Int      @id @default(autoincrement())
  wagerId          Int
  wager            Wager    @relation(fields: [wagerId], references: [id])
  userId           Int
  user             User     @relation(fields: [userId], references: [id])
  proposedStake    Int
  wantCreatorStake Int
  message          String?
  status           String   @default("pending") // pending, accepted, rejected
  createdAt        DateTime @default(now())
}

model Vote {
  id        Int      @id @default(autoincrement())
  wagerId   Int
  wager     Wager    @relation(fields: [wagerId], references: [id])
  userId    Int
  user      User     @relation(fields: [userId], references: [id])
  choice    String   // "for" or "against"
  createdAt DateTime @default(now())

  @@unique([wagerId, userId])
}
