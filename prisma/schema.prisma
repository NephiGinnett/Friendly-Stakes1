generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id        Int       @id @default(autoincrement())
  username  String    @unique
  pinHash   String
  pinSalt   String
  pinPlain  String    @default("")
  points            Int       @default(1000)
  totalDonated      Int       @default(0)
  challengeMultiplier Int     @default(1) // pending Inspiring Friend multiplier (2x) for next challenge created
  isAdmin           Boolean   @default(false)
  createdAt DateTime  @default(now())

  sessions           Session[]
  createdWagers      Wager[]           @relation("creator")
  wagerEntries       WagerEntry[]
  votes              Vote[]
  items              UserItem[]
  achievements       UserAchievement[]
  bingoSquares       BingoSquare[]
  challengesCreated  Challenge[]       @relation("ChallengeCreator")
  challengesTargeted Challenge[]       @relation("ChallengeTarget")
  challengesAccepted Challenge[]       @relation("ChallengeAcceptor")
  challengeVotes     ChallengeVote[]
  pointLogs          PointLog[]
  houseSpins         HouseSpin[]
  blackjackGame      BlackjackGame?
  houseDamageLogs    HouseDamageLog[]
  houseAttackLogs    HouseAttackLog[]
  houseBanDate       String            @default("")
  discordUserId      String?

  password      String  @default("")
  passwordHash  String  @default("")
  passwordSalt  String  @default("")

  adViewDate    String  @default("")
  adViewCount   Int     @default(0)
  hasWatchedAd  Boolean @default(false)
  syscoSubscriber Boolean @default(false)

  pwAssistHour  String  @default("")
  pwAssistCount Int     @default(0)
  sacrificeVotesCast SacrificeVote[]
  sacrificeVotesReceived SacrificeVote[] @relation("SacrificeTarget")

  distributionClaims AdminDistributionClaim[]

  publicWagerWins    Int               @default(0)
  publicWagerCount   Int               @default(0)

  bookmarkTokens     Int               @default(0)
  arGachaPulls       Int               @default(0)
  gachaPityCounter   Int               @default(0)
  sponsoredQuizzes   ArQuiz[]          @relation("QuizSponsor")
  arQuizAttempts     ArQuizAttempt[]
  arQuizCompletions  ArQuizCompletion[]
  userBookmarks      UserBookmark[]
  avatarAchievementId     String?
  worldCupEntry           WorldCupEntry?
  confidenceWagersWon     ConfidenceWager[] @relation("CWWinner")
  confidenceWagersLost    ConfidenceWager[] @relation("CWLoser")
  parlaysProposed         Parlay[]          @relation("ParlayProposer")
  parlaysOpposed          Parlay[]          @relation("ParlayOpponent")
  parlayVoteLogs          ParlayVoteLog[]
}

model Session {
  id        String   @id @default(cuid())
  userId    Int
  user      User     @relation(fields: [userId], references: [id])
  token     String   @unique
  createdAt DateTime @default(now())
}

model Wager {
  id              Int      @id @default(autoincrement())
  title           String
  description     String?
  creatorId       Int
  creator         User     @relation("creator", fields: [creatorId], references: [id])
  creatorPosition String
  creatorStake    Int

  deadline   DateTime
  status     String   @default("open") // open, started, voting, settled, cancelled
  winnerSide String?  // "for" or "against"
  settledAt  DateTime?
  settledBy  String?  // "vote" or "admin"
  vpnActive  Boolean  @default(false)
  vpnSeed    Int      @default(0)

  isPublic            Boolean @default(false)
  creatorLockedPayout Int     @default(0)

  publicFavorForVotes      Int @default(0)
  publicFavorForPts        Int @default(0)
  publicFavorAgainstVotes  Int @default(0)
  publicFavorAgainstPts    Int @default(0)

  createdAt DateTime     @default(now())
  entries   WagerEntry[]
  votes     Vote[]
  botEntries BotEntry[]
}

model WagerEntry {
  id        Int      @id @default(autoincrement())
  wagerId   Int
  wager     Wager    @relation(fields: [wagerId], references: [id])
  userId    Int
  user      User     @relation(fields: [userId], references: [id])
  side      String   // "for" or "against"
  stake     Int
  lockedPayout Int   @default(0) // locked return if they win (public wagers only)
  createdAt DateTime @default(now())

  @@unique([wagerId, userId])
}

model Vote {
  id        Int      @id @default(autoincrement())
  wagerId   Int
  wager     Wager    @relation(fields: [wagerId], references: [id])
  userId    Int
  user      User     @relation(fields: [userId], references: [id])
  choice    String   // "for" or "against"
  weight    Int      @default(1) // 1 = normal, 2 = thumb on the scale
  createdAt DateTime @default(now())

  @@unique([wagerId, userId])
}

// Purchased power-ups (earlybird can have multiple rows per user)
model UserItem {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id])
  itemType  String   // "xray", "thumb", "earlybird", "ward", etc.
  usesLeft  Int
  createdAt DateTime @default(now())
}

// Unlocked achievements (one row per user per achievement)
model UserAchievement {
  id            Int      @id @default(autoincrement())
  userId        Int
  user          User     @relation(fields: [userId], references: [id])
  achievementId String
  claimed       Boolean  @default(false)
  frozenData    String?  // JSON — used by fuck_you to store first-claimer info
  unlockedAt    DateTime @default(now())

  @@unique([userId, achievementId])
}

// Point change history
model PointLog {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id])
  amount    Int      // positive = gain, negative = loss
  reason    String   // human-readable label
  createdAt DateTime @default(now())
}

// Bingo items pool (added by admin)
model BingoItem {
  id           Int           @id @default(autoincrement())
  text         String
  providerName String
  createdAt    DateTime      @default(now())
  squares      BingoSquare[]
}

// Bounty-style challenges posted by players
model Challenge {
  id           Int       @id @default(autoincrement())
  title        String
  description  String?
  creatorId    Int
  creator      User      @relation("ChallengeCreator", fields: [creatorId], references: [id])
  targetId     Int?      // null = open to any player
  target       User?     @relation("ChallengeTarget", fields: [targetId], references: [id])
  acceptedById Int?      // who accepted it (set on acceptance)
  acceptedBy   User?     @relation("ChallengeAcceptor", fields: [acceptedById], references: [id])
  offer        Int       // pts escrowed by creator; 50 pt fee deducted at settlement
  multiplier   Int       @default(1) // payout multiplier from Inspiring Friend (1, 2, or 3)
  status       String    @default("pending") // pending, active, voting, settled, cancelled
  winnerUserId Int?      // acceptedById if completed, creatorId if refunded
  settledAt    DateTime?
  vpnActive    Boolean   @default(false)
  vpnSeed      Int       @default(0)
  createdAt    DateTime  @default(now())
  votes        ChallengeVote[]
}

model ChallengeVote {
  id          Int       @id @default(autoincrement())
  challengeId Int
  challenge   Challenge @relation(fields: [challengeId], references: [id])
  userId      Int
  user        User      @relation(fields: [userId], references: [id])
  choice      String    // "completed" or "incomplete"
  weight      Int       @default(1)
  createdAt   DateTime  @default(now())

  @@unique([challengeId, userId])
}

// ── The House ──────────────────────────────────────────────────────────────

// Global singleton (id=1 always)
model HouseConfig {
  id             Int      @id @default(1)
  phase          Int      @default(0)
  bossActive     Boolean  @default(false)
  bossHp         Int      @default(0)
  bossMaxHp      Int      @default(0)
  killerUserId   Int?
  nextStrikeAt   DateTime?
  sacrificeOpen     Boolean  @default(false)
  sacrificeBonusHp  Int      @default(0)
  casinoOpen        Boolean  @default(true)
  bossHpMultiplier  Int      @default(3000)
  botsEnabled       Boolean  @default(true)
  arFaireActive        Boolean  @default(true)
  leakAchievementId    String?  // currently displayed achievement
  leakRefreshedAt      DateTime?
  strikesSinceLeak     Int      @default(0) // resets to 0 after every-other-strike refresh
  worldCupAdminAt      DateTime? // admins can see 12h early
  worldCupPlayerAt  DateTime? // players see at this time
  worldCupEventEndAt DateTime?
  updatedAt         DateTime @updatedAt
}

model SacrificeVote {
  id           Int      @id @default(autoincrement())
  voterId      Int
  voter        User     @relation(fields: [voterId], references: [id])
  targetId     Int
  target       User     @relation("SacrificeTarget", fields: [targetId], references: [id])
  weight       Int      @default(1)
  createdAt    DateTime @default(now())

  @@unique([voterId])
}

model HouseSpin {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id])
  result    Int
  label     String
  item      String?
  createdAt DateTime @default(now())
}

model BlackjackGame {
  id          Int      @id @default(autoincrement())
  userId      Int      @unique
  user        User     @relation(fields: [userId], references: [id])
  playerHand  String
  dealerHand  String
  deck        String
  bet         Int
  status      String   @default("active")
  dailyPlays  Int      @default(0)
  dailyDate   String   @default("")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model HouseDamageLog {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id])
  amount    Int
  source    String
  createdAt DateTime @default(now())
}

model HouseAttackLog {
  id         Int      @id @default(autoincrement())
  userId     Int
  user       User     @relation(fields: [userId], references: [id])
  amount     Int
  flavorText String
  createdAt  DateTime @default(now())
}

// ── AR Faire ────────────────────────────────────────────────────────────────

model ArBookmark {
  id        Int      @id @default(autoincrement())
  label     String
  imageUrl  String   // base64 data URL or /bookmarks/ path
  tier      String   // "uncommon" | "rare" | "epic" | "legendary"
  quizId    Int?     @unique
  quiz      ArQuiz?  @relation(fields: [quizId], references: [id])
  createdAt DateTime @default(now())
  owners    UserBookmark[]
}

model ArQuiz {
  id          Int      @id @default(autoincrement())
  title       String
  author      String
  tier        String   // "uncommon" | "rare" | "epic" | "legendary"
  sponsorId   Int?
  sponsor     User?    @relation("QuizSponsor", fields: [sponsorId], references: [id])
  status      String   @default("pending") // "pending" | "approved" | "rejected" | "seeded"
  imageUrl    String?
  createdAt   DateTime @default(now())
  questions   ArQuestion[]
  attempts    ArQuizAttempt[]
  completions ArQuizCompletion[]
  bookmark    ArBookmark?
}

model ArQuestion {
  id           Int    @id @default(autoincrement())
  quizId       Int
  quiz         ArQuiz @relation(fields: [quizId], references: [id])
  order        Int
  text         String
  choiceA      String
  choiceB      String
  choiceC      String
  correctIndex Int
}

model ArQuizAttempt {
  id            Int      @id @default(autoincrement())
  userId        Int
  user          User     @relation(fields: [userId], references: [id])
  quizId        Int
  quiz          ArQuiz   @relation(fields: [quizId], references: [id])
  answers       String   // JSON array of chosen indices
  score         Int
  total         Int
  passed        Boolean
  tokensAwarded Int
  pointsAwarded Int
  createdAt     DateTime @default(now())
}

model ArQuizCompletion {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id])
  quizId    Int
  quiz      ArQuiz   @relation(fields: [quizId], references: [id])
  createdAt DateTime @default(now())
  @@unique([userId, quizId])
}

model UserBookmark {
  id         Int        @id @default(autoincrement())
  userId     Int
  user       User       @relation(fields: [userId], references: [id])
  bookmarkId Int
  bookmark   ArBookmark @relation(fields: [bookmarkId], references: [id])
  count      Int        @default(1)
  createdAt  DateTime   @default(now())
  @@unique([userId, bookmarkId])
}

// Admin-created point/item drops claimable by all players
model AdminDistribution {
  id             Int      @id @default(autoincrement())
  message        String
  rewardType     String   // "points" | "item"
  rewardAmount   Int      @default(0)  // used when rewardType = "points"
  rewardItem     String   @default("") // item type key when rewardType = "item"
  rewardItemUses Int      @default(1)
  createdAt      DateTime @default(now())
  claims         AdminDistributionClaim[]
}

model AdminDistributionClaim {
  id             Int                  @id @default(autoincrement())
  distributionId Int
  distribution   AdminDistribution    @relation(fields: [distributionId], references: [id])
  userId         Int
  user           User                 @relation(fields: [userId], references: [id])
  claimedAt      DateTime             @default(now())

  @@unique([distributionId, userId])
}

// Bot bets on public wagers
model BotEntry {
  id        Int      @id @default(autoincrement())
  wagerId   Int
  wager     Wager    @relation(fields: [wagerId], references: [id])
  side      String   // "for" or "against"
  stake     Int
  botType   String   // "unnamed" | "shark" | "momentum" | "house"
  createdAt DateTime @default(now())
}

// Persistent state for named bot personalities
model BotPersonality {
  id          Int    @id   // 1 = The Shark, 2 = The Momentum Player
  name        String
  wins        Int    @default(0)
  losses      Int    @default(0)
  lossStreak  Int    @default(0)
  pointsWon   Int    @default(0)
  pointsLost  Int    @default(0)
}

// Each player's bingo card (25 squares, positions 0–24)
model BingoSquare {
  id          Int       @id @default(autoincrement())
  userId      Int
  user        User      @relation(fields: [userId], references: [id])
  bingoItemId Int
  bingoItem   BingoItem @relation(fields: [bingoItemId], references: [id])
  position    Int       // 0–24 on the 5x5 grid
  claimStatus String    @default("none") // "none" | "pending" | "approved"
  claimNote   String?   // player's explanation when claiming
  claimedAt   DateTime?
  createdAt   DateTime  @default(now())

  @@unique([userId, position])
}

// ── World Cup 2026 ────────────────────────────────────────────────────────────

model WorldCupTeam {
  id            Int              @id @default(autoincrement())
  name          String           @unique
  code          String           @unique // e.g. "BRA", "USA"
  flag          String           // flag emoji
  confederation String           // UEFA, CONMEBOL, CONCACAF, CAF, AFC, OFC
  group         String?          // set once group draw happens
  entries       WorldCupEntry[]
  homeMatches   WorldCupMatch[]  @relation("HomeTeam")
  awayMatches   WorldCupMatch[]  @relation("AwayTeam")
}

model WorldCupEntry {
  id               Int          @id @default(autoincrement())
  userId           Int          @unique
  user             User         @relation(fields: [userId], references: [id])
  teamId           Int          @unique  // one player per team
  team             WorldCupTeam @relation(fields: [teamId], references: [id])
  paid             Int          @default(500)
  confidenceStake  Int          @default(100)
  monitorCans      Int          @default(0) // 🥤 MONITOR event currency
  createdAt        DateTime     @default(now())
}

model WorldCupMatch {
  id           Int              @id @default(autoincrement())
  fdMatchId    Int              @unique // football-data.org match id
  homeTeamId   Int?
  homeTeam     WorldCupTeam?    @relation("HomeTeam", fields: [homeTeamId], references: [id])
  awayTeamId   Int?
  awayTeam     WorldCupTeam?    @relation("AwayTeam", fields: [awayTeamId], references: [id])
  homeTeamName String
  awayTeamName String
  kickoff      DateTime
  stage        String           // "Group Stage", "Round of 32", etc.
  group        String?
  homeScore    Int?
  awayScore    Int?
  status       String           @default("SCHEDULED") // SCHEDULED, IN_PLAY, FINISHED, POSTPONED
  winner       String?          // "HOME_TEAM", "AWAY_TEAM", "DRAW"
  settled      Boolean          @default(false)
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  confidenceWagers ConfidenceWager[]
  parlays          Parlay[]
}

// Settlement receipt created automatically by cron when a match finishes.
// One record per pair of players whose teams faced each other.
model ConfidenceWager {
  id            Int           @id @default(autoincrement())
  matchId       Int
  match         WorldCupMatch @relation(fields: [matchId], references: [id])
  winnerId      Int
  winner        User          @relation("CWWinner", fields: [winnerId], references: [id])
  loserId       Int
  loser         User          @relation("CWLoser", fields: [loserId], references: [id])
  winnerStake   Int
  loserStake    Int
  winnerPayout  Int           // total received including any bonus
  bonusApplied  Boolean       @default(false)
  bonusAmount   Int           @default(0)
  settledAt     DateTime      @default(now())
}

// Parlay — proposed by higher-confidence player 2h before kickoff
// Multipliers: 1 active leg=×2, 2=×3, 3=×5, 4=×8, 5=×13
model Parlay {
  id              Int         @id @default(autoincrement())
  matchId         Int
  match           WorldCupMatch @relation(fields: [matchId], references: [id])
  proposerId      Int
  proposer        User        @relation("ParlayProposer", fields: [proposerId], references: [id])
  opponentId      Int
  opponent        User        @relation("ParlayOpponent", fields: [opponentId], references: [id])
  costPerLeg      Int         // 100 | 200 | 300
  status          String      @default("pending")
  // pending = awaiting opponent response (open until 1h before kickoff)
  // active   = match in progress / awaiting result
  // voting   = match finished, awaiting votes
  // settled  = paid out
  // cancelled
  proposerWon     Boolean?
  totalEscrowed   Int         @default(0)
  payout          Int         @default(0)
  createdAt       DateTime    @default(now())
  settledAt       DateTime?
  legs            ParlayLeg[]
}

model ParlayLeg {
  id              Int       @id @default(autoincrement())
  parlayId        Int
  parlay          Parlay    @relation(fields: [parlayId], references: [id])
  order           Int       // 1–5
  description     String
  accepted        Boolean?  // null=pending, true=accepted, false=rejected
  proposerVote    Boolean?  // true=success, false=fail
  opponentVote    Boolean?
  result          Boolean?  // final resolved result once both votes in
}

model ParlayVoteLog {
  id        Int      @id @default(autoincrement())
  parlayId  Int
  userId    Int
  user      User     @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())
  @@unique([parlayId, userId])
}
